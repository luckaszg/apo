{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "apo",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "apo",
			// Replace with the id printed by `npx wrangler d1 create apo` before the first deploy.
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Photos (portfolio, products), customer design files and transfer receipts.
			"binding": "BUCKET",
			"bucket_name": "apo-files"
		}
	],
	"vars": {
		"SITE_NAME": "apo"
	}
}
